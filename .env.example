# Copy to `.env` and fill in. `.env` is gitignored; this template is not.
#
# The key is optional: TickFlow's keyless endpoint already serves daily bars,
# instrument lists and the exchange catalog, which is all this plugin reads.
# A key switches to the full-service endpoint (fresher same-day bars, looser
# rate limits), but if your plan lacks the batch-kline entitlement the plugin
# falls back to one request per symbol automatically.
TICKFLOW_API_KEY=
